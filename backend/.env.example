# ──────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy this to backend/.env and fill in your API keys
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Lovable AI Gateway (primary fallback — powers existing Supabase Edge Fns) ─
LOVABLE_API_KEY=your_lovable_api_key_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenRouter (access 200+ models via one API key) ───────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── HuggingFace Inference API ─────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_...

# ── Ollama (Local) — change if running on a different host ───────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ENABLED=true

# ── LiteLLM Proxy (optional — start with: litellm --model ollama/llama3.2) ───
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-1234

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── MCP Agent (security) ──────────────────────────────────────────────────────
# Set to true only in trusted environments
MCP_ALLOW_SHELL=false
MCP_ALLOW_WRITE=false
MCP_MAX_STEPS=10
